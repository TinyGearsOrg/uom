<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.tinygears</groupId>
    <artifactId>uom-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>uom-codegen</artifactId>
  <name>uom-codegen</name>

  <!-- Build-time tool; never published. -->
  <properties>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <maven.source.skip>true</maven.source.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.tinygears</groupId>
      <artifactId>uom-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>javax.measure</groupId>
      <artifactId>unit-api</artifactId>
      <version>2.2</version>
    </dependency>
    <!-- Test only: the tests compile and run generated JSR-385 sources against the hand-written ones. -->
    <dependency>
      <groupId>org.tinygears</groupId>
      <artifactId>uom-jsr</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -q -B -Pgenerate -pl uom-codegen -am process-classes; the paths resolve against the repository root,
         which .mvn/ marks, wherever Maven is started. -->
    <profile>
      <id>generate</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>generate</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>org.tinygears.uom.codegen.Generate</mainClass>
                  <arguments>
                    <argument>${maven.multiModuleProjectDirectory}/data</argument>
                    <argument>${maven.multiModuleProjectDirectory}/uom-jsr/src/main/java/org/tinygears/uom/jsr/quantity</argument>
                    <argument>${maven.multiModuleProjectDirectory}/uom-jsr/src/main/java/org/tinygears/uom/jsr/systems</argument>
                    <argument>${maven.multiModuleProjectDirectory}/docs</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>generate-native</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>org.tinygears.uom.codegen.GenerateNative</mainClass>
                  <arguments>
                    <argument>${maven.multiModuleProjectDirectory}/data</argument>
                    <argument>${maven.multiModuleProjectDirectory}/uom/src/main/java/org/tinygears/uom/quantity</argument>
                    <argument>${maven.multiModuleProjectDirectory}/uom/src/main/java/org/tinygears/uom/systems</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- A literal, so no command-line flag can put this module into the Central bundle. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <configuration>
              <skipPublishing>true</skipPublishing>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
